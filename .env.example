# Kopiere diese Datei nach .env und fuelle die Werte aus.
# .env ist in .gitignore und darf niemals eingecheckt werden.

# --- Postgres (docker-compose) ---
POSTGRES_DB=flashcards
POSTGRES_USER=flashcards
POSTGRES_PASSWORD=flashcards

# --- Google Gemini (ab M4 benoetigt) ---
# Key aus Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
